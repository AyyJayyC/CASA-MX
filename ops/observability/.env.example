# Copy to .env (same folder). Never commit .env.

# Postgres for Bugsink itself. Not the app database.
POSTGRES_USER=bugsink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bugsink

# 50+ random chars. PowerShell: [Convert]::ToBase64String((1..50 | % { Get-Random -Max 256 }))
BUGSINK_SECRET_KEY=change-me-50-random-chars

# First login. Format is email:password — no colon allowed in the password.
BUGSINK_SUPERUSER=you@example.com:change-me

# Public URL of the Bugsink instance (set the https domain in production).
BUGSINK_BASE_URL=http://localhost:8000
BUGSINK_PORT=8000
# "true" when served over HTTPS behind a proxy.
BUGSINK_BEHIND_HTTPS_PROXY=false
