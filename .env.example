# Frontend public runtime configuration
# Copy to .env.local for local development
# For production, set these in Vercel/Railway dashboard

# Production URLs (required)
# NEXT_PUBLIC_API_URL is also used in the CSP connect-src directive (next.config.js)
# Set to production backend URL in Vercel/Preview environments
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Optional compatibility/fallback
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_MAPS_PROXY=http://localhost:3001

# Integrations (set in production dashboards)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Features
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=false

# First-party analytics (backend /analytics/events). Off unless explicitly enabled.
# provider: api | console | noop
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_PROVIDER=api

# Error monitoring (Sentry). The app no-ops until a DSN is present.
# Client DSN must be NEXT_PUBLIC_* so it is inlined at build time.
# Requires a redeploy after changing: the value is baked into the client bundle.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=

# Optional: source map upload during CI/Vercel builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
