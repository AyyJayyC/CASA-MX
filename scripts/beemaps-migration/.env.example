# ===== Beemaps (source) — public API, no login needed =====
# Inmobiliaria username from https://www.beemaps.com.mx/inmobiliaria/<username>
BEEMAPS_INMOBILIARIA=mrcesar
BEEMAPS_BASE_URL=https://www.beemaps.com.mx

# ===== CASA MX (target) =====
# For production: https://api.casa-mx.com
# For staging:  http://localhost:3001  (or your staging backend URL)
CASA_MX_API_URL=http://localhost:3001
CASA_MX_EMAIL=your@casa-mx.com
CASA_MX_PASSWORD=yourpassword

# ===== Behavior =====
# Delay between API calls in ms. POST create + PATCH images + PUBLISH = 3 calls/property.
# Rate limit: 100 POST creates per 15 minutes. Keep REQUEST_DELAY >= 9000 for safety.
REQUEST_DELAY=9000

# 0 = migrate all properties, N = limit to first N
MAX_PROPERTIES=0

# true = fetch + transform only, no actual CASA MX API calls
DRY_RUN=true

# Skip fetching, use cached JSON file instead
SKIP_FETCH=false

# Browser: false = show the Chrome window (needed first run to pass Cloudflare once)
HEADLESS=false
